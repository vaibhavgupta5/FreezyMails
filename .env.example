# Database. Use a Postgres URL; with Supabase use the Session pooler (IPv4) URL.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Supabase auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (Gmail connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Security
SMTP_ENCRYPTION_KEY=
CRON_SECRET=

# AI (profile fact extraction)
GEMINI_API_KEY=

# Optional: raises GitHub API rate limits for profile import
GITHUB_TOKEN=
